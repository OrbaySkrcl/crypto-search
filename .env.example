# ============================================================================
#  ALPHA HUNTER — yapilandirma
#  Bu dosyayi `.env` olarak kopyala ve doldur. Railway'de bunlari
#  Variables sekmesine gir.
# ============================================================================

# --- GENEL -----------------------------------------------------------------
ENV=prod
LOG_LEVEL=INFO
# Odaklanilacak zincirler (virgullu). Solana memecoin hacminin buyuk kismini tutar.
CHAINS=solana

# --- VERITABANI ------------------------------------------------------------
# Lokal test:
DATABASE_URL=sqlite:///alpha_hunter.db
# Railway PostgreSQL eklediginde bu degisken otomatik gelir; elle ezme.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# --- TWITTER KAZIMA --------------------------------------------------------
# Oncelik sirasi. Ilk calisan kullanilir: nitter,apify,xapi,twscrape
TWEET_SOURCES=nitter,apify
INGEST_LOOKBACK_MINUTES=90
INGEST_MAX_TWEETS_PER_RUN=800

# Nitter — bedava, anahtarsiz. Ornekler duser/kalkar, listeyi guncel tut.
NITTER_INSTANCES=https://nitter.net,https://nitter.poast.org,https://xcancel.com,https://nitter.privacyredirect.com,https://lightbrd.com

# Apify — odemeli ama guvenilir. https://console.apify.com/account/integrations
APIFY_TOKEN=
APIFY_ACTOR=apidojo/tweet-scraper

# Resmi X API (bearer token) — ucretsiz katmanda arama YOK
X_BEARER_TOKEN=

# Aranacak sorgular ( | ile ayrilir )
SEARCH_QUERIES=pump.fun/coin | dexscreener.com/solana | "CA:" solana | "contract:" solana | $SOL memecoin CA

# Ayrica zaman cizelgesi taranacak hesaplar (virgullu, @ olmadan)
WATCHLIST_HANDLES=

# --- FIYAT / ON-CHAIN ------------------------------------------------------
# Birdeye anahtari VARSA fiyat hassasiyeti ciddi artar (1dk mumlar).
# https://bds.birdeye.so
BIRDEYE_API_KEY=
# Helius RPC — anti-scam kontrolleri icin. Bos birakilirsa public RPC kullanilir
# (yavas ve limitli). https://dashboard.helius.dev
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- DEGERLENDIRME ---------------------------------------------------------
WIN_MULTIPLE=3.0                 # >=3x ise cagri "basarili"
MOON_MULTIPLE=10.0
EVAL_CLOSE_AFTER_HOURS=168       # 7 gun sonra cagri kapanir
SUSTAINED_HIGH_MINUTES=15        # ATH degil, 15dk korunan tepe esas alinir
MIN_ENTRY_LIQUIDITY_USD=2000
RUG_LIQUIDITY_DROP_PCT=0.90

# --- SKORLAMA --------------------------------------------------------------
SCORE_WINDOW_DAYS=120
SCORE_HALFLIFE_DAYS=45           # eski basarilarin yari omru
MIN_CALLS_FOR_RATING=4
SPRAY_SOFT_CALLS_PER_DAY=3       # bunun ustunde ceza baslar
SPRAY_HARD_CALLS_PER_DAY=25      # bunun ustunde otomatik kara liste

# --- TELEGRAM ALARMLARI ----------------------------------------------------
# @BotFather ile bot olustur, token'i buraya yapistir.
TELEGRAM_BOT_TOKEN=
# Kendi chat id'n: bota mesaj at, sonra
# https://api.telegram.org/bot<TOKEN>/getUpdates adresinden oku
TELEGRAM_CHAT_ID=
ALERTS_ENABLED=true
ALERT_MIN_ALPHA_SCORE=65         # A tier ve ustu cagrilarda haber ver
# NOT: TELEGRAM_CHAT_ID ayni zamanda GUVENLIK sinididir -- bot yalnizca bu
# sohbetten komut kabul eder. Bos birakilirsa butun komutlar reddedilir.
ALERT_MAX_ENTRY_MC_USD=3000000

# --- WEB PANOSU ------------------------------------------------------------
# `run` komutu isciyle birlikte panoyu da acar. Railway PORT'u kendi verir.
WEB_ENABLED=true
WEB_USER=admin
# BOS BIRAKMA! Bos ise pano internete sifresiz acilir.
WEB_PASSWORD=

# --- ZAMANLAMA (worker) ----------------------------------------------------
INGEST_INTERVAL_MINUTES=10
ENRICH_INTERVAL_MINUTES=5
SCORE_INTERVAL_MINUTES=60
