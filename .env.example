# ============================================================================
#  ALPHA HUNTER — yapilandirma
#  Bu dosyayi `.env` olarak kopyala ve doldur. Railway'de bunlari
#  Variables sekmesine gir.
# ============================================================================

# --- GENEL -----------------------------------------------------------------
ENV=prod
LOG_LEVEL=INFO
# Odaklanilacak zincirler (virgullu). Solana memecoin hacminin buyuk kismini tutar.
CHAINS=solana

# --- VERITABANI ------------------------------------------------------------
# Lokal test:
DATABASE_URL=sqlite:///alpha_hunter.db
# Railway PostgreSQL eklediginde bu degisken otomatik gelir; elle ezme.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# --- TWITTER KAZIMA --------------------------------------------------------
# Oncelik sirasi. Ilk calisan kullanilir: nitter,apify,xapi,twscrape
TWEET_SOURCES=nitter,apify
INGEST_LOOKBACK_MINUTES=90
INGEST_MAX_TWEETS_PER_RUN=800

# Nitter — bedava, anahtarsiz. Ornekler duser/kalkar, listeyi guncel tut.
NITTER_INSTANCES=https://nitter.net,https://nitter.poast.org,https://xcancel.com,https://nitter.privacyredirect.com,https://lightbrd.com

# Apify — odemeli ama guvenilir. https://console.apify.com/account/integrations
APIFY_TOKEN=
# Aktor calismiyorsa panodaki "Baglanti testi" alternatif onerir.
# Denenebilecekler: apidojo/tweet-scraper, apidojo/twitter-scraper-lite,
#                   kaitoeasyapi/twitter-x-data-tweet-scraper
APIFY_ACTOR=apidojo/twitter-scraper-lite
# Apify SONUC BASINA ucretlendirir ve zamanlanmis dongu 7/24 calisir.
# Gunluk tavan koymazsan fatura sessizce buyur. 0 = sinirsiz.
APIFY_DAILY_TWEET_BUDGET=4000
# Aktor isini bitirene kadar beklenecek toplam sure (saniye). Kisa tutmak
# "ucreti oder ama sonucu alma" hatasina yol acar.
APIFY_MAX_WAIT_SECONDS=420

# Resmi X API (bearer token) — ucretsiz katmanda arama YOK
X_BEARER_TOKEN=

# Aranacak sorgular ( | ile ayrilir )
SEARCH_QUERIES=pump.fun/coin | dexscreener.com/solana | "CA:" solana | "contract:" solana | $SOL memecoin CA

# Ayrica zaman cizelgesi taranacak hesaplar (virgullu, @ olmadan)
WATCHLIST_HANDLES=

# --- FIYAT / ON-CHAIN ------------------------------------------------------
# Birdeye anahtari VARSA fiyat hassasiyeti ciddi artar (1dk mumlar).
# https://bds.birdeye.so
BIRDEYE_API_KEY=
# Helius RPC — anti-scam kontrolleri icin. Bos birakilirsa public RPC kullanilir
# (yavas ve limitli). https://dashboard.helius.dev
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- DEGERLENDIRME ---------------------------------------------------------
WIN_MULTIPLE=3.0                 # >=3x ise cagri "basarili"
MOON_MULTIPLE=10.0
EVAL_CLOSE_AFTER_HOURS=168       # 7 gun sonra cagri kapanir
SUSTAINED_HIGH_MINUTES=15        # ATH degil, 15dk korunan tepe esas alinir
MIN_ENTRY_LIQUIDITY_USD=2000
RUG_LIQUIDITY_DROP_PCT=0.90

# --- SKORLAMA --------------------------------------------------------------
SCORE_WINDOW_DAYS=120
SCORE_HALFLIFE_DAYS=45           # eski basarilarin yari omru
MIN_CALLS_FOR_RATING=4
SPRAY_SOFT_CALLS_PER_DAY=3       # bunun ustunde ceza baslar
SPRAY_HARD_CALLS_PER_DAY=25      # bunun ustunde otomatik kara liste

# --- TELEGRAM ALARMLARI ----------------------------------------------------
# @BotFather ile bot olustur, token'i buraya yapistir.
TELEGRAM_BOT_TOKEN=
# Kendi chat id'n: bota mesaj at, sonra
# https://api.telegram.org/bot<TOKEN>/getUpdates adresinden oku
TELEGRAM_CHAT_ID=
ALERTS_ENABLED=true
ALERT_MIN_ALPHA_SCORE=65         # A tier ve ustu cagrilarda haber ver
# NOT: TELEGRAM_CHAT_ID ayni zamanda GUVENLIK sinididir -- bot yalnizca bu
# sohbetten komut kabul eder. Bos birakilirsa butun komutlar reddedilir.
ALERT_MAX_ENTRY_MC_USD=3000000

# --- WEB PANOSU ------------------------------------------------------------
# `run` komutu isciyle birlikte panoyu da acar. Railway PORT'u kendi verir.
WEB_ENABLED=true
WEB_USER=admin
# BOS BIRAKMA! Bos ise pano internete sifresiz acilir.
WEB_PASSWORD=

# --- ZAMANLAMA (worker) ----------------------------------------------------
INGEST_INTERVAL_MINUTES=10
ENRICH_INTERVAL_MINUTES=5
SCORE_INTERVAL_MINUTES=60


# ============================================================================
#  RADAR — akilli para konfluans botu  (bkz. docs/RADAR.md)
#  Zorunlu olan YALNIZCA iki degisken var: TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID
#  Hicbir ucretli API anahtari gerekmez.
# ============================================================================

# --- ZINCIR ----------------------------------------------------------------
# Virgullu liste. Her ek zincir bedava API kotasindan yer yer; solana ile basla.
# Desteklenen: solana, ethereum, base, bsc, arbitrum, polygon
RADAR_CHAINS=solana

# --- KESIF -----------------------------------------------------------------
# Bu likiditenin altindaki havuz hic kaydedilmez: orada gorulen kat
# girilebilir degildir, olcumu de yalan olur.
MIN_POOL_LIQUIDITY_USD=8000
# Ayni anda aktif izlenen token tavani. Bedava kotayi asil bu belirler.
MAX_ACTIVE_TOKENS=300
# Her turda kac tokenin islem defteri orneklenir
TRADES_SAMPLE_PER_CYCLE=25
# Bunun altindaki islemler gurultu sayilir (bot/dust)
MIN_TRADE_USD=150

# --- CUZDAN SICILI ---------------------------------------------------------
# Kadroya girmek icin gereken sonuclanmis alim sayisi
WALLET_MIN_EVALUATED=4
# Alimdan sonra >= bu kat ise "isabet"
WALLET_WIN_MULTIPLE=2.0
# Bir alimin sonuclanmasi icin beklenen sure (saat)
WALLET_EVAL_HOURS=48
# Gunde bundan fazla farkli tokene dokunan cuzdan = sprey/bot -> engellenir
WALLET_MAX_TOKENS_PER_DAY=12
# Ortalama alimi bunun altinda olan cuzdan = dust -> engellenir
WALLET_MIN_AVG_BUY_USD=100
# Kadroya girmek icin gereken skor (0-100)
WALLET_SMART_SCORE_MIN=60

# --- SINYALLER -------------------------------------------------------------
# KONFLUANS: kac bagimsiz akilli cuzdan, kac saat icinde
CONFLUENCE_MIN_WALLETS=3
CONFLUENCE_WINDOW_HOURS=8
CONFLUENCE_COOLDOWN_HOURS=24
# HACIM: 1 saatlik hacim kendi 24s ortalamasinin kac kati olursa kart cikar
VOLUME_SPIKE_MULTIPLE=6.0
VOLUME_SPIKE_MIN_H1_USD=40000
VOLUME_COOLDOWN_HOURS=12
# Her alarmda gecerli taban esikler
ALERT_MIN_LIQUIDITY_USD=15000
ALERT_MAX_MC_USD=20000000
ALERT_MIN_TOKEN_AGE_MINUTES=20
# Guvenlik skoru esigi (0 = cop, 1 = temiz)
ALERT_MIN_SAFETY_SCORE=0.35
# Sessiz saatler (UTC, "23-7" gibi). Bos = kapali.
# Konfluans kartlari sessiz saatte de gonderilir; digerleri susturulur.
QUIET_HOURS_UTC=

# --- TAKIP LISTESI ---------------------------------------------------------
WATCH_PRICE_PCT=25
WATCH_MAX_TOKENS=50

# --- KARNE -----------------------------------------------------------------
JOURNAL_HOURS=1,6,24
# Korunmus tepe girisin bu katini gecerse "isabet"
JOURNAL_WIN_MULTIPLE=2.0
# 24 saat sonunda girisin bu oraninin altindaysa "zarar"
JOURNAL_LOSS_MULTIPLE=0.7
# ATH degil: en az bu kadar dakika korunan tepe esas alinir
SUSTAINED_MINUTES=10

# --- ZAMANLAMA (dakika) ----------------------------------------------------
DISCOVER_INTERVAL_MINUTES=10
TRADES_INTERVAL_MINUTES=3
PRICE_INTERVAL_MINUTES=5
SCORE_INTERVAL_MINUTES=60
JOURNAL_INTERVAL_MINUTES=15
SNAPSHOT_RETENTION_DAYS=30
